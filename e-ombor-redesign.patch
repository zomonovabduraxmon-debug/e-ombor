-    if(!raw) raw = 'Sheet';
-    raw = raw.slice(0,31);
-    let candidate = raw;
-    let i = 2;
-    const exists = name => {
-      const lower = name.toLowerCase();
-      for(const v of used){ if(String(v).toLowerCase() === lower) return true; }
-      return false;
-    };
-    while(exists(candidate)){
-      const suffix = '_' + i++;
-      candidate = raw.slice(0, 31 - suffix.length) + suffix;
-    }
-    used.add(candidate);
-    return candidate;
-  }
