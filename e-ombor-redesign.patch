-/* ==========================================================
-   TEXTILE CLIENT V9
-   Chosen client layout: left rail + clean header + textile
-   dashboard surfaces. Presentation only.
-   ========================================================== */
-
-html.v9-shell-ready{
-  --v9-navy:#072a62;
-  --v9-navy-2:#0b397c;
-  --v9-blue:#0a58ca;
-  --v9-ink:#0b2b62;
-  --v9-muted:#70829b;
-  --v9-line:#dce5ef;
-  --v9-card:#ffffff;
-  --v9-bg:#f7f9fc;
