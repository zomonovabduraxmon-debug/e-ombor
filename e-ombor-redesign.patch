-          resolve({recentPermitIds:new Set(),recentShipmentIds:new Set()});
-          return;
-        }
-
-        request.onerror = ()=>resolve({recentPermitIds:new Set(),recentShipmentIds:new Set()});
-        request.onsuccess = ()=>{
-          const db = request.result;
