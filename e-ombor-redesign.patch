-    function translateDOM(rootEl){
-      const rootNode = rootEl || document.body;
-      if(!rootNode) return;
-      const walker = document.createTreeWalker(rootNode, NodeFilter.SHOW_TEXT);
-      const nodes = [];
-      let n;
-      while((n = walker.nextNode())){
