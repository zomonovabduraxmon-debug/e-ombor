-.export-panel-body-v7{
-  padding:0 !important;
-  background:transparent !important;
-  display:block !important;
-}
-
-.export-card-v7{
-  position:relative;
-  display:grid;
-  grid-template-columns:72px minmax(0,1fr) auto;
-  align-items:center;
-  gap:20px;
-  min-height:134px;
-  padding:24px 26px;
-  overflow:hidden;
-  background:
-    radial-gradient(circle at 88% 12%,rgba(23,104,255,.09),transparent 30%),
