-            return;
-          }
-
-          const tx = db.transaction('records','readonly');
-          const get = tx.objectStore('records').getAll();
-          get.onerror = ()=>{
-            db.close();
-            resolve({recentPermitIds:new Set(),recentShipmentIds:new Set()});
-          };
