-html.v9-shell-ready body{
-  min-height:100vh;
-  background:
-    linear-gradient(rgba(249,251,253,.94),rgba(249,251,253,.94)),
-    url("./textile-v9.svg") center top / cover fixed no-repeat,
-    #f7f9fc !important;
-  color:var(--v9-ink)!important;
-}
