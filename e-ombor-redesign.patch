-
-/* ==========================================================
-   STYLE 2 — presentation-only override for e-ombor
-   This file intentionally contains NO data/sync/business logic.
-   ========================================================== */
-
-:root{
-  --s2-bg:#f4f7fb;
-  --s2-panel:#ffffff;
-  --s2-text:#182236;
-  --s2-muted:#708099;
-  --s2-line:#e5ebf3;
-  --s2-blue:#2463eb;
-  --s2-blue-deep:#173b71;
-  --s2-blue-soft:#eaf1ff;
-  --s2-amber:#e79716;
-  --s2-amber-soft:#fff5df;
-  --s2-red:#e44b4b;
-  --s2-red-soft:#ffebeb;
-  --s2-green:#21976f;
-  --s2-green-soft:#e6f7f1;
-  --s2-shadow:0 8px 28px rgba(28,45,78,.07);
-  --s2-shadow-hover:0 13px 34px rgba(28,45,78,.11);
-}
-
-/* ----- Page ----- */
-body{
-  background:var(--s2-bg) !important;
-  color:var(--s2-text);
-}
-
-.wrap{
-  max-width:1240px !important;
-  padding:28px 30px 38px !important;
-}
-
-/* ----- Header / brand ----- */
-.topbar{
-  background:#fff !important;
-  color:var(--s2-text) !important;
-  padding:14px 30px 0 !important;
-  border-bottom:1px solid var(--s2-line) !important;
-  box-shadow:0 2px 14px rgba(28,45,78,.035);
-}
-
-.topbar-inner{
-  max-width:1240px !important;
-  align-items:center !important;
-  min-height:62px;
-}
-
-.brand{gap:14px !important;}
-
-.brand-logo{
-  height:58px !important;
-  border-radius:14px !important;
-  border:1px solid #edf1f6;
-  background:#fff !important;
-  padding:5px 10px !important;
-  box-shadow:0 5px 14px rgba(25,45,79,.07);
-  transform-style:preserve-3d;
-  animation:logo-flip-style2 12s ease-in-out infinite !important;
-}
-
-@keyframes logo-flip-style2{
-  0%,91.666%{transform:rotateY(0deg);}
-  100%{transform:rotateY(360deg);}
-}
-
-.brand-text{gap:2px !important;}
-
-.brand-mark{
-  color:#1d2940 !important;
-  font-family:var(--sans) !important;
-  font-size:22px !important;
-  font-weight:800 !important;
-  letter-spacing:.2px !important;
-}
-
-.brand-sub{
-  color:#8996a8 !important;
-  font-size:12px !important;
-}
-
-.topbar-actions{gap:10px !important;}
-
-.sync-pill,
-.auth-btn{
-  min-height:34px;
-  display:inline-flex;
-  align-items:center;
-  border-radius:999px !important;
-  padding:6px 12px !important;
-  font-size:11.5px !important;
-}
-
-.sync-pill{
-  color:#2a6b57 !important;
-  background:#ecf8f3 !important;
-  border:1px solid #d6eee5 !important;
-}
-
-.auth-btn{
-  color:#30425e !important;
